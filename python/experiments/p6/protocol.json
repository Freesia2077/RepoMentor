  "tool_definitions": [
    {
      "type": "function",
      "function": {
        "name": "search_code",
        "description": "Search source/tests; returns at most 3 locations and short exact excerpts. Use English identifiers; match=literal for an exact substring. Empty results: change query. Optional path is an exact repository path. Read relevant ranges with read_code.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "\\S"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "match": {
              "type": "string",
              "enum": [
                "ranked",
                "literal"
              ]
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "search_docs",
        "description": "Search README/docs/config (not source). Same bounded locations/excerpts as search_code. Use English keywords; empty results do not prove absence.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "\\S"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "match": {
              "type": "string",
              "enum": [
                "ranked",
                "literal"
              ]
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "read_code",
        "description": "Read exact source or documentation lines from the snapshot. Supply path, start_line, end_line. At most 100 lines, bounded bytes; next_line means more remains. Only shown lines can be cited.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "path",
            "start_line",
            "end_line"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "trace_dependencies",
        "description": "Resolve static local imports of one source path. Returns related paths, not a runtime call graph. External/dynamic imports may be unresolved; read returned paths before making claims.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "find_tests",
        "description": "Find candidate tests for a source path, optionally with a symbol query. Returns short excerpts; read relevant test ranges to verify assertions. A match does not prove executed coverage.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "\\S"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "limits": {
    "max_tool_calls": 6,
    "max_decisions": 8,
    "timeout_seconds": 180,
    "max_observation_bytes": 6000,
    "max_source_bytes": 18000
  },
  "retrieval": {
    "chunker": "syntax",
    "retriever": "bm25",
    "device": "cpu",
    "query_expansion": true
  },
