              "end_line": 94,
              "content": "    Alternatively it can also be used around a specific generator::\n\n        from flask import stream_with_context, request, Response\n\n        @app.route('/stream')\n        def streamed_response():\n            def generate():\n                yield 'Hello '\n                yield request.args['name']\n                yield '!'\n            return Response(stream_with_context(generate()))",
              "content_sha256": "2f85b44a447f09f1abb5e8b941227dab9975880344c5fa9d12ddc9b16cc8e9e6",
              "visible_to_generator": true
