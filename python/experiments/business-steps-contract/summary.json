              "end_line": 64,
              "content": "def stream_with_context(\n    generator_or_function: t.Iterator[t.AnyStr] | t.Callable[..., t.Iterator[t.AnyStr]],\n) -> t.Iterator[t.AnyStr] | t.Callable[[t.Iterator[t.AnyStr]], t.Iterator[t.AnyStr]]:",
              "content_sha256": "923c644266ba9045762fd789d5dbe942076c21525ff6867ac1a54564105415b4",
