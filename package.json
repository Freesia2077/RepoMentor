{
  "name": "repomentor",
  "version": "0.3.2",
  "description": "AI-powered open-source repository learning assistant",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "repomentor": "scripts/start.mjs"
  },
  "files": [
    ".claude-plugin",
    "agents",
    "dist",
    "eval",
    "scripts/evaluate-agentic-results.mjs",
    "scripts/start.mjs",
    "skills",
    "web/dist"
  ],
  "scripts": {
    "dev:backend": "node --watch --watch-preserve-output --import tsx src/index.ts",
    "dev:frontend": "npm run dev --workspace=web",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "node scripts/clean-backend-dist.mjs && tsc && node scripts/copy-static-assets.mjs",
    "build:frontend": "npm run build --workspace=web",
    "build": "npm run build:frontend && npm run build:backend",
    "prepack": "npm run build",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:agentic": "node scripts/evaluate-agentic-results.mjs"
  },
  "workspaces": [
    "web"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.224",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "simple-git": "^3.27.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
