{
  "name": "repomentor",
  "version": "0.2.2",
  "description": "AI-powered open-source repository learning assistant",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:backend": "node --watch --import tsx src/index.ts",
    "dev:frontend": "npm run dev --workspace=web",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "tsc && node scripts/copy-static-assets.mjs",
    "build:frontend": "npm run build --workspace=web",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "workspaces": [
    "web"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "simple-git": "^3.27.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
